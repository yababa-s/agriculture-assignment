# Copy to .env (git-ignored) and edit. Every variable is optional: the defaults below are used when unset.
# Never commit real keys.

# --- Naming (TEAMID_STATE_ARTIFACT_vN)
TEAM_ID=34

# --- Paths (relative to the repository root, or absolute)
# CORPUS_DIR=data/raw
# DB_PATH=db/34_AN_knowledgebase_v2.sqlite

# --- LLM backend: mlx (Apple Silicon) | hf (transformers + peft, any OS) | none (rules only)
# Default: mlx on Apple Silicon, none elsewhere.
# LLM_BACKEND=mlx
# BASE_MODEL=mlx-community/Qwen2.5-3B-Instruct-4bit
# HF_BASE_MODEL=Qwen/Qwen2.5-3B-Instruct
# ADAPTER_PATH=adapters/34_AN_qlora_v1
# LLM_MAX_TOKENS=1500

# --- Hugging Face (only needed if the model download is rate-limited)
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx

# --- LangSmith tracing and evaluation runs (optional; local JSONL traces are always written)
# LANGSMITH_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LANGSMITH_PROJECT=34_AN_agriagent
